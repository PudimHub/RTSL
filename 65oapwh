-- Pega o melhor dano das armas no inventário
local function getBestWeaponDamage()
    local best = 0
    local bp = Player.Backpack
    for _, tool in ipairs(bp:GetChildren()) do
        if tool:IsA("Tool") then
            local dmg = 0
            pcall(function()
                dmg = tool:GetAttribute("Damage") or 0
            end)
            if dmg == 0 then
                pcall(function()
                    local dmgVal = tool:FindFirstChild("Damage")
                    if dmgVal then dmg = dmgVal.Value end
                end)
            end
            if dmg == 0 then
                pcall(function()
                    local dmgVal = tool:FindFirstChild("AttackDamage")
                    if dmgVal then dmg = dmgVal.Value end
                end)
            end
            if dmg == 0 then
                local name = tool.Name:lower()
                if name:find("spear") or name:find("sword") then dmg = 25
                elseif name:find("axe") then dmg = 20
                elseif name:find("revolver") or name:find("rifle") then dmg = 35
                elseif name:find("crossbow") or name:find("bow") then dmg = 30
                elseif name:find("hammer") or name:find("club") then dmg = 40
                else dmg = 15 end
            end
            if dmg > best then best = dmg end
        end
    end
    if best == 0 then best = 15
    return best
end

-- Pega o melhor dano de machado
local function getBestAxeDamage()
    local best = 0
    local bp = Player.Backpack
    for _, tool in ipairs(bp:GetChildren()) do
        if tool:IsA("Tool") then
            local name = tool.Name:lower()
            if name:find("axe") or name:find("chainsaw") then
                local dmg = 0
                pcall(function()
                    dmg = tool:GetAttribute("Damage") or 0
                end)
                if dmg == 0 then
                    pcall(function()
                        local dmgVal = tool:FindFirstChild("Damage")
                        if dmgVal then dmg = dmgVal.Value end
                    end)
                end
                if dmg == 0 then
                    if name:find("chainsaw") then dmg = 35
                    elseif name:find("ice") then dmg = 30
                    elseif name:find("strong") or name:find("good") then dmg = 25
                    else dmg = 15 end
                end
                if dmg > best then best = dmg end
            end
        end
    end
    if best == 0 then best = 15
    return best
end

-- Verifica se é um mob (inimigo)
local function isMob(model)
    if not model or not model:IsA("Model") then return false end
    -- Ignora jogadores
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl.Character == model then return false end
    end
    -- Tem Humanoid e não é jogador?
    local hum = model:FindFirstChildWhichIsA("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    return true
end

-- Verifica se é uma árvore
local function isTree(model)
    if not model or not model:IsA("Model") then return false end
    local name = model.Name:lower()
    return name:find("tree") or name:find("wood") or name:find("log") or name:find("stump")
end

-- Pega mobs no range
local function getMobsInRange(origin, radius)
    local list = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        pcall(function()
            if not isMob(obj) then return end
            local hrp = obj:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local dist = (hrp.Position - origin).Magnitude
            if dist <= radius then
                table.insert(list, {model = obj, hrp = hrp})
            end
        end)
    end
    return list
end

-- Pega árvores no range
local function getTreesInRange(origin, radius)
    local list = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        pcall(function()
            if not isTree(obj) then return end
            local part = obj:FindFirstChildWhichIsA("BasePart")
            if not part then return end
            local dist = (part.Position - origin).Magnitude
            if dist <= radius then
                table.insert(list, obj)
            end
        end)
    end
    return list
end

