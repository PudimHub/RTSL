-- SLIDER DRAG LOGIC
-- ═══════════════════════════════════════════════════════════════

local function setupSlider(track, fill, knob, valueLabel, minVal, maxVal, defaultValue, callback)
    local dragging = false
    local currentValue = defaultValue
    
    local function setValue(pct)
        pct = math.clamp(pct, 0, 1)
        currentValue = math.round(minVal + (maxVal - minVal) * pct)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        knob.Position = UDim2.new(pct, 0, 0.5, 0)
        valueLabel.Text = tostring(currentValue) .. " st"
        callback(currentValue)
    end
    
    local sliderBtn = Instance.new("TextButton")
    sliderBtn.BackgroundTransparency = 1
    sliderBtn.Size = UDim2.new(1, 20, 1, 20)
    sliderBtn.Position = UDim2.new(0, -10, 0, -10)
    sliderBtn.Text = ""
    sliderBtn.Parent = track
    
    sliderBtn.MouseButton1Down:Connect(function()
        dragging = true
        local ap = track.AbsolutePosition
        local as = track.AbsoluteSize
        setValue((UserInputService:GetMouseLocation().X - ap.X) / as.X)
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        local ap = track.AbsolutePosition
        local as = track.AbsoluteSize
        setValue((input.Position.X - ap.X) / as.X)
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    -- Inicializa
    local pct = (defaultValue - minVal) / (maxVal - minVal)
    setValue(pct)
    
    return setValue
end

