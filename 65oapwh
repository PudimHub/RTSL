local function startTreeAura()
    if treeLoop then treeLoop:Disconnect(); treeLoop = nil end
    
    local lastAttack = 0
    treeLoop = RunService.Heartbeat:Connect(function()
        if not treeAuraEnabled then return end
        
        local now = tick()
        if now - lastAttack < 0.2 then return end
        
        local ch = Player.Character
        if not ch then return end
        local hrp = ch:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        local damage = getBestAxeDamage()
        local trees = getTreesInRange(hrp.Position, treeRange)
        
        if #trees == 0 then return end
        
        lastAttack = now
        
        for _, tree in ipairs(trees) do
            task.spawn(function()
                damageTreeWithRemotes(tree, damage)
            end)
        end
    end)
end

local function stopTreeAura()
    if treeLoop then
        treeLoop:Disconnect()
        treeLoop = nil
    end
end

