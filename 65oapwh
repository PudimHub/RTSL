-- KILL AURA CORE — USANDO OS 3 REMOTES QUE FUNCIONARAM
-- ═══════════════════════════════════════════════════════════════

local function damageMobWithRemotes(mob, damage)
    local success = false
    
    -- 1. ClientTriggerNPCAttack (✅ FUNCIONOU!)
    if remotes.npcAttack then
        pcall(function()
            -- Tenta diferentes formas de chamar
            remotes.npcAttack:FireServer(mob, damage)
            success = true
        end)
        if not success then
            pcall(function()
                remotes.npcAttack:FireServer(mob)
                success = true
            end)
        end
        if not success then
            pcall(function()
                local hrp = mob:FindFirstChild("HumanoidRootPart")
                if hrp then
                    remotes.npcAttack:FireServer(hrp, damage)
                    success = true
                end
            end)
        end
    end
    
    -- 2. DamagePlayer (✅ FUNCIONOU!)
    if remotes.damagePlayer then
        pcall(function()
            remotes.damagePlayer:FireServer(mob, damage)
            success = true
        end)
        if not success then
            pcall(function()
                remotes.damagePlayer:FireServer(mob)
                success = true
            end)
        end
        if not success then
            pcall(function()
                local hum = mob:FindFirstChildWhichIsA("Humanoid")
                if hum then
                    remotes.damagePlayer:FireServer(hum, damage)
                    success = true
                end
            end)
        end
    end
    
    -- 3. CrystalTorchHit (✅ FUNCIONOU!)
    if remotes.torchHit then
        pcall(function()
            remotes.torchHit:FireServer(mob, damage)
            success = true
        end)
        if not success then
            pcall(function()
                remotes.torchHit:FireServer(mob)
                success = true
            end)
        end
        if not success then
            pcall(function()
                local hrp = mob:FindFirstChild("HumanoidRootPart")
                if hrp then
                    remotes.torchHit:FireServer(hrp, damage)
                    success = true
                end
            end)
        end
    end
    
    return success
end

local function startKillAura()
    if killLoop then killLoop:Disconnect(); killLoop = nil end
    
    local lastAttack = 0
    killLoop = RunService.Heartbeat:Connect(function()
        if not killAuraEnabled then return end
        
        local now = tick()
        if now - lastAttack < 0.15 then return end
        
        local ch = Player.Character
        if not ch then return end
        local hrp = ch:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        local damage = getBestWeaponDamage()
        local mobs = getMobsInRange(hrp.Position, killRange)
        
        if #mobs == 0 then return end
        
        lastAttack = now
        
        for _, mob in ipairs(mobs) do
            task.spawn(function()
                damageMobWithRemotes(mob.model, damage)
            end)
        end
    end)
end

local function stopKillAura()
    if killLoop then
        killLoop:Disconnect()
        killLoop = nil
    end
end

